# Better Auth
# NUXT_BETTER_AUTH_SECRET overrides runtimeConfig.betterAuthSecret at runtime.
# Required in production - generate a long random string, e.g.:
#   openssl rand -base64 32
NUXT_BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# NUXT_PUBLIC_BETTER_AUTH_URL overrides runtimeConfig.public.betterAuthUrl.
# Set it to exactly the URL people open in the browser (scheme, host and
# port): sign-in and sign-up from any other origin fail with 403. Extra
# origins (e.g. a LAN address next to a domain) go in
# BETTER_AUTH_TRUSTED_ORIGINS, comma-separated (no spaces, no trailing slash).
NUXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Database (SQLite file path)
# NUXT_DB_FILE_PATH overrides runtimeConfig.dbFilePath. The containing
# directory is created automatically if it does not exist yet.
NUXT_DB_FILE_PATH=./data/app.db

# Docker Compose only (compose.yaml; docs/DEVELOPMENT.md, "Docker"). In a
# container the app always listens on port 3000 and keeps its database in
# /app/data; compose.yaml pins NUXT_DB_FILE_PATH and the port, so these
# settings choose the host side instead. Change NUXT_PUBLIC_BETTER_AUTH_URL
# above to match: compose.yaml defaults it to http://localhost:<YGO_ALPHA_PORT>
# only when it isn't set at all.
# YGO_ALPHA_PORT is the host port (default 3000).
# YGO_ALPHA_PORT=8080
# YGO_ALPHA_DATA_DIR is the host folder for the database (default ./data).
# Create it before the first start and give it to YGO_ALPHA_USER (Docker
# would create it as root). Start the path with ./ or /: anything else is
# read as the name of a Docker volume, and compose.yaml declares none.
# YGO_ALPHA_DATA_DIR=/volume1/docker/ygo-alpha/data
# YGO_ALPHA_USER is the uid:gid the app runs as (default: the image's `nuxt`
# user, 1001:1001); `id -u` and `id -g` print your own.
# YGO_ALPHA_USER=1026:100

# Invite-only sign-up (docs/adr/0027-invite-code-and-admin-token.md)
# NUXT_INVITE_CODE overrides runtimeConfig.inviteCode: one shared code the
# register form asks for (case, spaces and dashes are ignored). Leave empty
# for open sign-up (local dev); set it on any public host.
NUXT_INVITE_CODE=
# NUXT_ADMIN_TOKEN overrides runtimeConfig.adminToken: the bearer token for
# POST /api/admin/catalog/sync and /api/admin/catalog/translations/sync
# (`Authorization: Bearer <token>`). Empty = those endpoints are off.
# Generate one with: openssl rand -hex 32
NUXT_ADMIN_TOKEN=

# Chat assistant (/assistant, incl. deck assistance) / KI-Assistent
# The assistant talks to the endpoint through the Vercel AI SDK
# (@ai-sdk/openai-compatible, docs/adr/0020-assistant-on-the-ai-sdk.md).
# Works with any OpenAI-compatible Chat Completions endpoint, e.g. OpenAI,
# OpenRouter, Ollama, LM Studio, or OpenCode Zen.
# NUXT_ASSISTANT_PROVIDER selects the backing model: '' (auto-detect from the
# API key or a custom base URL), 'openai', or 'fake' (deterministic, no
# network — useful for local dev and E2E tests). Leave empty and set an API
# key (or a custom base URL for a keyless local server) to enable it.
NUXT_ASSISTANT_PROVIDER=
# NUXT_ASSISTANT_BASE_URL overrides runtimeConfig.assistant.baseUrl
# (default: https://api.openai.com/v1). Point this at another
# OpenAI-compatible endpoint, e.g. https://openrouter.ai/api/v1 or
# http://localhost:11434/v1 for Ollama.
NUXT_ASSISTANT_BASE_URL=
# NUXT_ASSISTANT_API_KEY overrides runtimeConfig.assistant.apiKey. If left
# empty, it falls back to the OPENAI_API_KEY env var; leave both empty for a
# keyless local server (Ollama, LM Studio).
NUXT_ASSISTANT_API_KEY=
# NUXT_ASSISTANT_MODEL overrides the model id (default: gpt-4o-mini).
NUXT_ASSISTANT_MODEL=
# NUXT_ASSISTANT_MODELS is an optional comma-separated list of model ids the
# user may pick from in the chat (a model picker next to the photo buttons;
# the choice is remembered per device). The ids go to the provider as they
# are. NUXT_ASSISTANT_MODEL is the default when it's on the list, else the
# list's first entry. Empty = only NUXT_ASSISTANT_MODEL, and no picker.
NUXT_ASSISTANT_MODELS=
# NUXT_ASSISTANT_REASONING_EFFORT is sent as `reasoning_effort` when set
# (low | medium | high). Some gateways (e.g. OpenCode Go) require it for
# certain models; leave empty otherwise.
NUXT_ASSISTANT_REASONING_EFFORT=
# NUXT_ASSISTANT_VISION_MODEL overrides the model used for a chat turn that
# contains an image (Phase 8's chat assistant, /assistant). Leave empty to
# use NUXT_ASSISTANT_MODEL for image turns too; set this only if your
# provider's default model isn't the (best) vision-capable one it offers.
NUXT_ASSISTANT_VISION_MODEL=
# NUXT_ASSISTANT_TITLE_MODEL names a conversation after its first exchange
# (a short title in the interface language; #129), on the same endpoint.
# Empty = glm-5.3-flash (OpenCode Go's fast model; set your provider's cheap
# model otherwise). 'off' keeps the first message as the title. A failing
# title model never affects the chat: the first message stays the title.
NUXT_ASSISTANT_TITLE_MODEL=
#
# NUXT_ASSISTANT_LIMITS_* override runtimeConfig.assistant.limits — six
# operational limits for the Phase 8 chat assistant (/assistant), widened
# for a single-user, cost-watching deployment. Each falls back to the
# default shown below when unset or not a positive integer; see
# server/utils/assistant-limits.ts (getAssistantLimits).
# NUXT_ASSISTANT_LIMITS_MAX_TOOL_ROUNDS=24
# NUXT_ASSISTANT_LIMITS_TOOL_RESULT_ITEMS=100
# NUXT_ASSISTANT_LIMITS_TOOL_RESULT_CHARS=60000
# NUXT_ASSISTANT_LIMITS_HISTORY_MESSAGES=120
# NUXT_ASSISTANT_LIMITS_HISTORY_CHARS=160000
# NUXT_ASSISTANT_LIMITS_TIMEOUT_MS=300000
#
# Example: OpenCode Go subscription (not pay-per-use Zen, which is /zen/v1);
# https://opencode.ai/zen/go/v1/models lists the available models. Go
# requires an `x-opencode-session` header on every request; the app sends
# it automatically (see docs/adr/0010-chat-assistant-with-tools.md), no
# extra configuration needed here. mimo-v2.6-pro (MiMo V2.6 Pro) is the
# recommended model: it handles streamed tool calls and image_url data URLs
# (so no NUXT_ASSISTANT_VISION_MODEL is needed).
# reasoning_effort is optional for it (low | medium | high); glm-5.3-flash
# is a faster, cheaper alternative.
#   NUXT_ASSISTANT_PROVIDER=openai
#   NUXT_ASSISTANT_BASE_URL=https://opencode.ai/zen/go/v1
#   NUXT_ASSISTANT_API_KEY=<your key>
#   NUXT_ASSISTANT_MODEL=mimo-v2.6-pro
#   NUXT_ASSISTANT_MODELS=mimo-v2.6-pro,glm-5.3-flash,deepseek-v4.1-flash
#   NUXT_ASSISTANT_REASONING_EFFORT=low
