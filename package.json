    "@nuxt/test-utils": "^4.4.0",
    "@playwright/test": "^1.65.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.6",
    "@vue/test-utils": "^2.5.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "jsonc-eslint-parser": "^3.3.0",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.3.5",
