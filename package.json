    "@vite-pwa/nuxt": "^1.1.1",
    "ai": "^7.0.166",
    "better-auth": "^1.7.18",
    "better-sqlite3": "^12.11.1",
    "comark": "^0.7.0",
    "drizzle-orm": "^0.45.4",
    "h3": "^1.15.11",
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
