{
  "name": "ygo-alpha",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "preview": "nuxt preview",
